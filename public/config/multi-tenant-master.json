{
  "version": "1.0.0",
  "systemName": "BGE Multi-Tenant Educational Platform",
  "description": "Sistema configurable para instituciones educativas",
  "
": "2025-09-25",

  "tenantConfigTemplate": {
    "institution": {
      "name": "{{INSTITUTION_NAME}}",
      "shortName": "{{INSTITUTION_SHORT_NAME}}",
      "type": "{{INSTITUTION_TYPE}}",
      "level": "{{EDUCATION_LEVEL}}",
      "address": {
        "street": "{{STREET_ADDRESS}}",
        "city": "{{CITY}}",
        "state": "{{STATE}}",
        "country": "{{COUNTRY}}",
        "postalCode": "{{POSTAL_CODE}}"
      },
      "contact": {
        "phone": "{{MAIN_PHONE}}",
        "email": "{{MAIN_EMAIL}}",
        "website": "{{WEBSITE_URL}}"
      },
      "coordinates": {
        "latitude": "{{LATITUDE}}",
        "longitude": "{{LONGITUDE}}"
      }
    },

    "branding": {
      "primaryColor": "{{PRIMARY_COLOR}}",
      "secondaryColor": "{{SECONDARY_COLOR}}",
      "accentColor": "{{ACCENT_COLOR}}",
      "logoUrl": "{{LOGO_URL}}",
      "faviconUrl": "{{FAVICON_URL}}",
      "heroImageUrl": "{{HERO_IMAGE_URL}}",
      "fontFamily": "{{FONT_FAMILY}}"
    },

    "leadership": {
      "director": {
        "name": "{{DIRECTOR_NAME}}",
        "title": "{{DIRECTOR_TITLE}}",
        "photo": "{{DIRECTOR_PHOTO}}",
        "bio": "{{DIRECTOR_BIO}}"
      },
      "subdirector": {
        "name": "{{SUBDIRECTOR_NAME}}",
        "title": "{{SUBDIRECTOR_TITLE}}",
        "photo": "{{SUBDIRECTOR_PHOTO}}"
      },
      "coordinator": {
        "name": "{{COORDINATOR_NAME}}",
        "title": "{{COORDINATOR_TITLE}}",
        "photo": "{{COORDINATOR_PHOTO}}"
      }
    },

    "socialMedia": {
      "facebook": "{{FACEBOOK_URL}}",
      "instagram": "{{INSTAGRAM_URL}}",
      "twitter": "{{TWITTER_URL}}",
      "youtube": "{{YOUTUBE_URL}}"
    },

    "academicInfo": {
      "missionStatement": "{{MISSION_STATEMENT}}",
      "visionStatement": "{{VISION_STATEMENT}}",
      "values": ["{{VALUE_1}}", "{{VALUE_2}}", "{{VALUE_3}}"],
      "educationalPrograms": [
        {
          "name": "{{PROGRAM_NAME}}",
          "description": "{{PROGRAM_DESCRIPTION}}",
          "duration": "{{PROGRAM_DURATION}}"
        }
      ],
      "accreditation": "{{ACCREDITATION_INFO}}",
      "establishedYear": "{{ESTABLISHED_YEAR}}"
    },

    "features": {
      "chatbotEnabled": true,
      "paymentsEnabled": true,
      "calendarEnabled": true,
      "gradesEnabled": true,
      "appointmentsEnabled": true,
      "newsEnabled": true,
      "downloadsEnabled": true,
      "communityEnabled": true
    },

    "localization": {
      "language": "es",
      "timezone": "{{TIMEZONE}}",
      "currency": "{{CURRENCY}}",
      "dateFormat": "{{DATE_FORMAT}}"
    }
  },

  "availableTemplates": [
    {
      "id": "mexican-bachillerato",
      "name": "Bachillerato Mexicano",
      "description": "Plantilla para bachilleratos en México",
      "features": ["sep-integration", "ceneval", "planea"],
      "regions": ["mexico"]
    },
    {
      "id": "international-highschool",
      "name": "International High School",
      "description": "Plantilla para escuelas preparatorias internacionales",
      "features": ["multilingual", "international-curriculum"],
      "regions": ["global"]
    },
    {
      "id": "technical-institute",
      "name": "Instituto Técnico",
      "description": "Plantilla para institutos técnicos",
      "features": ["technical-programs", "industry-partnerships"],
      "regions": ["latin-america"]
    }
  ],

  "supportedRegions": [
    {
      "id": "mexico",
      "name": "México",
      "currency": "MXN",
      "timezone": "America/Mexico_City",
      "language": "es",
      "regulatoryBody": "SEP"
    },
    {
      "id": "colombia",
      "name": "Colombia",
      "currency": "COP",
      "timezone": "America/Bogota",
      "language": "es",
      "regulatoryBody": "MinEducación"
    },
    {
      "id": "argentina",
      "name": "Argentina",
      "currency": "ARS",
      "timezone": "America/Buenos_Aires",
      "language": "es",
      "regulatoryBody": "MinEducación"
    }
  ],

  "configurationMethods": {
    "json": {
      "enabled": true,
      "path": "/config/tenant-config.json",
      "validation": true
    },
    "ui": {
      "enabled": true,
      "path": "/admin/configuration",
      "requireAuth": true
    },
    "api": {
      "enabled": true,
      "path": "/api/configuration",
      "requireAuth": true,
      "rateLimited": true
    }
  }
}