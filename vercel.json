{
  "version": 2,
  "builds": [
    {
      "src": "api/app.js",
      "use": "@vercel/node@3.x",
      "config": { "includeFiles": ["backend/**"] }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/app.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=1, stale-while-revalidate" }
      ]
    }
  ]
}