{
  "version": 2,
  "builds": [
    {
      "src": "api/index.cjs",
      "use": "@vercel/node@3.x",
      "config": { "includeFiles": ["backend/**"] }
    }
  ],
      "routes": [
        { "src": "/api/(.*)", "dest": "/api/index.cjs" },
        { "src": "/(.*)", "dest": "/public/$1" }
      ]
    }