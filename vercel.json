{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/app.js"
    },
    {
      "source": "/manifest.json",
      "destination": "/public/manifest.json"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, max-age=0, must-revalidate" }
      ]
    },

  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["iad1"],
  "outputDirectory": "public"
}