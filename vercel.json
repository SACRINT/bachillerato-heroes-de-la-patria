{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/legacy-backend/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["iad1"],
  "functions": {
    "legacy-backend/api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": ["server/**", "legacy-backend/config/**"]
    }
  }
}