{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/egresados",
      "destination": "/api/egresados.js"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth.js"
    },
    {
      "source": "/api/students-auth",
      "destination": "/api/students-auth.js"
    },
    {
      ""source": "/api/(.*)",
      "destination": "/backend/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["iad1"],
  "functions": {
    "backend/api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": ["server/**", "lib/**"]
    },
    "api/egresados.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": ["lib/**"]
    },
    "api/auth.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": ["lib/**"]
    },
    "api/students-auth.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": ["lib/**", "data/students.json"]
    }
  }
}