{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/egresados",
      "destination": "/api/egresados.js"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth.js"
    },
    {
      "source": "/api/students-auth",
      "destination": "/api/students-auth.js"
    },
    {
      "source": "/api/contact",
      "destination": "/api/contact.js"
    },
    {
      "source": "/api/inscriptions",
      "destination": "/api/inscriptions.js"
    },
    {
      "source": "/api/subscriptions",
      "destination": "/api/subscriptions.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["iad1"],
  "functions": {
    "api/egresados.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "lib/**"
    },
    "api/auth.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "lib/**"
    },
    "api/students-auth.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "lib/**,data/students.json"
    },
    "api/contact.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "lib/**,server/services/verificationService.js"
    },
    "api/inscriptions.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "lib/**,data/inscriptions.json,data/activities.json,server/services/verificationService.js"
    },
    "api/subscriptions.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "lib/**,data/subscribers.json,data/newsletters.json,server/services/verificationService.js"
    }
  }
}