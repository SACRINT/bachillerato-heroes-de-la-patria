# dentro de config/, no a la carpeta completa.
# Mantengo la regla original, pero con esta nota.
config/

# Package lock (mantener package-lock.json es una buena práctica para builds reproducibles)
# La línea original estaba comentada, la elimino para asegurar que se incluya.
# package-lock.json # NO IGNORAR - ESENCIAL PARA BUILDS REPRODUCIBLES

