{
  "name": "bachillerato-heroes-mobile",
  "version": "1.0.0",
  "description": "Aplicación Móvil del Bachillerato Héroes de la Patria - iOS & Android",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint .",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace BachilleratoHeroes.xcworkspace -scheme BachilleratoHeroes -configuration Release",
    "clean:android": "cd android && ./gradlew clean",
    "clean:ios": "cd ios && xcodebuild clean"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.6",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/stack": "^6.3.20",
    "react-native-screens": "^3.27.0",
    "react-native-safe-area-context": "^4.7.4",
    "react-native-gesture-handler": "^2.13.4",
    "react-native-reanimated": "^3.5.4",
    "@react-native-async-storage/async-storage": "^1.19.5",
    "axios": "^1.6.2",
    "react-native-vector-icons": "^10.0.2",
    "@react-native-firebase/app": "^18.7.0",
    "@react-native-firebase/messaging": "^18.7.0",
    "react-native-push-notification": "^8.1.1",
    "react-native-chart-kit": "^6.12.0",
    "react-native-svg": "^14.0.0",
    "react-native-webview": "^13.6.3",
    "react-native-image-picker": "^7.0.3",
    "react-native-permissions": "^3.10.1",
    "react-native-config": "^1.5.1",
    "react-native-keychain": "^8.1.2",
    "react-native-biometrics": "^3.0.1",
    "formik": "^2.4.5",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@babel/runtime": "^7.23.4",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@tsconfig/react-native": "^3.0.2",
    "@types/react": "^18.2.38",
    "@types/react-test-renderer": "^18.0.7",
    "babel-jest": "^29.7.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "0.76.9",
    "prettier": "^3.1.0",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "mobile",
    "education",
    "bachillerato"
  ],
  "author": "Bachillerato Héroes de la Patria",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SACRINT/bachillerato-heroes-de-la-patria.git"
  },
  "bugs": {
    "url": "https://github.com/SACRINT/bachillerato-heroes-de-la-patria/issues"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
