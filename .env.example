# ============================================
# CONFIGURACIÓN DE ENTORNO - BGE PROJECT
# ============================================
# Copia este archivo como .env y configura tus valores

# ============================================
# SECRETS OBLIGATORIOS (Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
# ============================================
SESSION_SECRET=your_session_secret_here_64_chars
JWT_SECRET=your_jwt_secret_here_64_chars

# ============================================
# BASE DE DATOS POSTGRESQL (Neon)
# ============================================
DATABASE_URL=postgresql://user:password@host/database

# ============================================
# REDIS CACHE (Opcional - para Socket.IO y cache-service)
# ============================================
REDIS_URL=redis://localhost:6379
# Si no tienes Redis instalado, socket-service usará fallback en memoria

# ============================================
# EMAIL SERVICE (Para notificaciones y subscriptions)
# ============================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# ============================================
# GOOGLE OAUTH (Para login con Google)
# ============================================
GOOGLE_OAUTH_CLIENT_ID_DEV=your_dev_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID_PROD=your_prod_client_id.apps.googleusercontent.com

# ============================================
# AI PROVIDERS (Opcional - para IA features)
# ============================================
OPENAI_API_KEY=sk-your_openai_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# ============================================
# SMS SERVICE - TWILIO (Opcional - para SMS notifications)
# ============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# FIREBASE CLOUD MESSAGING (Opcional - para push notifications)
# ============================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ============================================
# STRIPE PAYMENT (Opcional - para payment.service.js)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# SEP INTEGRATION (Opcional - para sep-integration.service.js)
# ============================================
SEP_API_URL=https://api.sep.gob.mx
SEP_API_KEY=your_sep_api_key

# ============================================
# SERVIDOR
# ============================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ============================================
# TINYMCE (Para WYSIWYG editor)
# ============================================
TINYMCE_API_KEY=your_tinymce_api_key
