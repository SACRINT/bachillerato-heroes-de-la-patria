graph TD
    subgraph Fuentes
        User[Usuario Web]
        DB[(PostgreSQL Core)]
        Docs[Documentos PDF]
    end

    subgraph "Capa de Ingesta & ETL"
        API_Logs[API: Log Interaction]
        Cron_Grades[Cron: Sync Grades]
        Script_Docs[Script: Ingest Docs]
    end

    subgraph "Plataforma de Datos (Data Platform)"
        subgraph "Almacenamiento Caliente"
            Redis_Cache[(Redis Cache)]
            Redis_Queue[(Redis Queue)]
        end
        
        subgraph "Almacenamiento Analítico"
            PG_Analytics[(PG: Analytics Tables)]
            PG_Logs[(PG: Interaction Logs)]
            FeatureStore[(PG: Feature Store)]
        end

        subgraph "Memoria Vectorial"
            Pinecone[(Pinecone Vector DB)]
        end
    end

    subgraph "Consumidores IA"
        Model_Risk[Modelo Riesgo (Offline)]
        Agent_Tutor[Agente Tutor]
        Dashboard_Admin[Dashboard Analytics]
    end

    %% Flujos
    User -->|Chat/Click| API_Logs
    API_Logs -->|Sanitize & Insert| PG_Logs
    
    DB -->|Read Grades| Cron_Grades
    Cron_Grades -->|Transform & Load| FeatureStore
    Cron_Grades -->|Event: Updated| Redis_Queue
    
    Docs -->|Parse| Script_Docs
    Script_Docs -->|Embed| Pinecone
    
    Agent_Tutor -->|Query Context| Pinecone
    Agent_Tutor -->|Check History| Redis_Cache
    Agent_Tutor -->|Read Profile| FeatureStore
    
    FeatureStore -->|Train| Model_Risk
    Model_Risk -->|Update Score| PG_Analytics
    
    PG_Analytics -->|Visuals| Dashboard_Admin
