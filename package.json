{
  "name": "bachillerato-heroes-patria-website",
  "version": "1.0.0",
  "description": "Sitio web oficial del Bachillerato General Estatal Héroes de la Patria",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "cd server && npm start",
    "dev": "cd server && npm run dev",
    "build": "npx webpack --mode production",
    "install-server": "cd server && npm install",
    "docs:install": "node scripts/docs-automation/master-docs.js --install",
    "docs:update": "node scripts/docs-automation/master-docs.js --update",
    "docs:maps": "node scripts/docs-automation/master-docs.js --maps",
    "docs:cleanup": "node scripts/docs-automation/master-docs.js --cleanup",
    "docs:cleanup-dry": "node scripts/docs-automation/master-docs.js --cleanup --dry-run",
    "docs:full": "node scripts/docs-automation/master-docs.js --full",
    "lint:js": "eslint js/**/*.js --fix",
    "lint:html": "htmlhint *.html",
    "lint:css": "stylelint css/**/*.css --fix",
    "lint": "npm run check-errors",
    "format": "prettier --write js/**/*.js css/**/*.css *.html",
    "fix-all": "npm run lint:js && npm run lint:css && npm run format",
    "check-errors": "npm run lint:js && npm run lint:html && npm run lint:css",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ci": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "education",
    "bachillerato",
    "website",
    "node.js"
  ],
  "author": "BGE Héroes de la Patria",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "@babel/runtime": "^7.28.4",
    "archiver": "^7.0.1",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "compression": "^1.7.4",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "express-validator": "^7.0.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.6",
    "openai": "^4.104.0",
    "pg": "^8.16.3",
    "sharp": "^0.34.4",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@types/jest": "^30.0.0",
    "babel-loader": "^10.0.0",
    "compression-webpack-plugin": "^11.1.0",
    "core-js": "^3.46.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.36.0",
    "glob": "^10.4.5",
    "htmlhint": "^1.7.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jshint": "^2.13.6",
    "postcss-loader": "^8.2.0",
    "prettier": "^3.6.2",
    "style-loader": "^4.0.0",
    "stylelint": "^16.24.0",
    "supertest": "^7.1.4",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.102.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1"
  }
}
