{
  "name": "bachillerato-heroes-patria-website",
  "version": "8.0.0",
  "description": "Sitio web oficial del Bachillerato General Estatal Héroes de la Patria - DAO Refactoring Completado",
  "type": "commonjs",
  "main": "backend/server.js",
  "scripts": {
    "start": "cd backend && npm start",
    "dev": "cd backend && npm run dev",
    "build": "npm run build:frontend",
    "build:webpack": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "build:analyze": "cross-env ANALYZE=true webpack --mode production",
    "build:watch": "webpack --mode development --watch",
    "dev:frontend": "vite",
    "build:frontend": "tsc && vite build",
    "preview": "vite preview",
    "install-server": "cd backend && npm install",
    "docs:install": "node scripts/docs-automation/master-docs.js --install",
    "docs:update": "node scripts/docs-automation/master-docs.js --update",
    "docs:maps": "node scripts/docs-automation/master-docs.js --maps",
    "docs:cleanup": "node scripts/docs-automation/master-docs.js --cleanup",
    "docs:cleanup-dry": "node scripts/docs-automation/master-docs.js --cleanup --dry-run",
    "docs:full": "node scripts/docs-automation/master-docs.js --full",
    "lint:js": "eslint js/**/*.js --fix",
    "lint:html": "htmlhint *.html",
    "lint:css": "stylelint css/**/*.css --fix",
    "lint": "npm run check-errors",
    "format": "prettier --write js/**/*.js css/**/*.css *.html",
    "fix-all": "npm run lint:js && npm run lint:css && npm run format",
    "check-errors": "npm run lint:js && npm run lint:html && npm run lint:css",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ci": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "education",
    "bachillerato",
    "website",
    "node.js"
  ],
  "author": "BGE Héroes de la Patria",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "isomorphic-dompurify": "^2.32.0",
    "jsonwebtoken": "^9.0.2",
    "leva": "^0.10.1",
    "moment": "^2.30.1",
    "pg": "^8.11.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.182.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@faker-js/faker": "^10.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-loader": "^10.0.0",
    "compression-webpack-plugin": "^11.1.0",
    "copy-webpack-plugin": "^13.0.1",
    "core-js": "^3.46.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^3.0.1",
    "glob": "^10.4.5",
    "html-webpack-plugin": "^5.6.4",
    "htmlhint": "^1.7.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jshint": "^2.13.6",
    "postcss-loader": "^8.2.0",
    "prettier": "^3.6.2",
    "style-loader": "^4.0.0",
    "stylelint": "^16.24.0",
    "supertest": "^7.1.4",
    "terser-webpack-plugin": "^5.3.14",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "webpack": "^5.102.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1"
  }
}
