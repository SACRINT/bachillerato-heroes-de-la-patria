            "text": "{\n  \"docentes\": [\n    {\n      \"id\": 1,\n      \"name\": \"Director General\",\n      \"nombre\": \"Dr. Miguel Ángel Herrera\",\n      \"position\": \"Director\",\n      \"subjects\": [\"Administración Educativa\"],\n      \"photo\": \"images/docentes/director.jpg\",\n      \"email\": \"direccion@heroesdelapatria.edu.mx\",\n      \"telefono\": \"55-1234-5678\",\n      \"specialization\": \"Administración Educativa\",\n      \"grado\": \"Doctorado en Administración Educativa\",\n      \"experiencia\": \"15 años\",\n      \"horario\": \"Matutino y Vespertino\",\n      \"estado\": \"Activo\",\n      \"fechaIngreso\": \"2009-08-01\",\n      \"salario\": 45000,\n      \"cedula\": \"1234567890\"\n    },\n    {\n      \"id\": 2,\n      \"name\": \"Subdirectora Académica\",\n      \"nombre\": \"Mtra. Carmen López Ruiz\",\n      \"position\": \"Subdirectora\",\n      \"subjects\": [\"Coordinación Académica\"],\n      \"photo\": \"images/docentes/subdirectora.jpg\",\n      \"email\": \"academica@heroesdelapatria.edu.mx\",\n      \"telefono\": \"55-2345-6789\",\n      \"specialization\": \"Desarrollo Curricular\",\n      \"grado\": \"Maestría en Desarrollo Curricular\",\n      \"experiencia\": \"12 años\",\n      \"horario\": \"Matutino y Vespertino\",\n      \"estado\": \"Activo\",\n      \"fechaIngreso\": \"2012-01-15\",\n      \"salario\": 38000,\n      \"cedula\": \"2345678901\"\n    },\n    {\n      \"id\": 3,\n      \"name\": \"Profesor de Matemáticas\",\n      \"nombre\": \"Ing. Carlos Rodríguez Hernández\",\n      \"position\": \"Docente\",\n      \"subjects\": [\"Matemáticas I\", \"Matemáticas II\", \"Cálculo Diferencial\"],\n      \"photo\": \"images/docentes/matematicas.jpg\",\n      \"email\": \"matematicas@heroesdelapatria.edu.mx\",\n      \"telefono\": \"55-3456-7890\",\n      \"specialization\": \"Matemáticas Aplicadas\",\n      \"grado\": \"Ingeniería en Matemáticas\",\n      \"experiencia\": \"8 años\",\n      \"horario\": \"Matutino