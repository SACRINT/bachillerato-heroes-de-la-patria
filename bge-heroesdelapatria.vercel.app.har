          "content": {
            "size": 2914,
            "mimeType": "application/json",
            "text": "{\n  \"eventos\": [\n    {\n      \"id\": \"evento-001\",\n      \"titulo\": \"Conferencia: Preparación para la Universidad\",\n      \"descripcion\": \"Conferencia magistral sobre estrategias de estudio y preparación para el ingreso a la educación superior, dirigida a estudiantes de 5to y 6to semestre. Expertos en orientación educativa compartirán técnicas de estudio, proceso de selección universitaria y becas disponibles.\",\n      \"fecha\": \"2024-10-15\",\n      \"hora\": \"10:00\",\n      \"lugar\": \"Auditorio Principal\",\n      \"organizador\": \"Departamento de Orientación Educativa\",\n      \"cupoMaximo\": 200,\n      \"inscripcionRequerida\": true,\n      \"categoria\": \"académico\",\n      \"imagen\": \"images/eventos/conferencia-universidad.jpg\",\n      \"contacto\": \"orientacion@bgeheroes.edu.mx\",\n      \"requisitos\": [\"Ser estudiante de 5to o 6to semestre\", \"Registro previo obligatorio\"],\n      \"activo\": true,\n      \"destacado\": true,\n      \"fechaCreacion\": \"2024-09-15T09:00:00Z\",\n      \"tags\": [\"universidad\", \"orientación\", \"estudiantes\", \"educación superior\"]\n    },\n    {\n      \"id\": \"evento-002\",\n      \"titulo\": \"Festival Cultural de Otoño\",\n      \"descripcion\": \"Celebración de la diversidad cultural con presentaciones artísticas, gastronómicas y exposiciones de los diferentes estados de México. Habrá bailes folclóricos, muestra gastronómica, exposición de artesanías y concursos culturales.\",\n      \"fecha\": \"2024-11-20\",\n      \"hora\": \"09:00\",\n      \"lugar\": \"Explanada Central\",\n      \"organizador\": \"Comité Cultural\",\n      \"cupoMaximo\": null,\n      \"inscripcionRequerida\": false,\n      \"categoria\": \"cultural\",\n      \"imagen\": \"images/eventos/festival-cultural.jpg\",\n      \"contacto\": \"cultural@bgeheroes.edu.mx\",\n      \"requisitos\": [],\n      \"activo\": true,\n      \"destacado\": true,\n      \"fechaCreacion\": \"2024-09-12T16:00:00Z\",\n      \"tags\": [\"cultura\", \"festival\", \"arte\", \"tradiciones\", \"México\"]\n    },\n    {\n      \"id\": \"evento-003\",\n      \"titulo\": \"Torneo Intersemestral de Futbol\",\n      \"descripcion\": \"Competencia deportiva entre todos los semestres del bachillerato. Fomenta el deporte, la sana competencia y el trabajo en equipo entre nuestros estudiantes.\",\n      \"fecha\": \"2024-10-05\",\n      \"hora\": \"15:00\",\n      \"lugar\": \"Cancha de Futbol\",\n      \"organizador\": \"Coordinación de Deportes\",\n      \"cupoMaximo\": 120,\n      \"inscripcionRequerida\": true,\n      \"categoria\": \"deportivo\",\n      \"imagen\": \"images/eventos/torneo-futbol.jpg\",\n      \"contacto\": \"deportes@bgeheroes.edu.mx\",\n      \"requisitos\": [\"Equipos de 11 jugadores por semestre\", \"Certificado médico vigente\"],\n      \"activo\": true,\n      \"destacado\": false,\n      \"fechaCreacion\": \"2024-09-08T14:00:00Z\",\n      \"tags\": [\"deporte\", \"futbol\", \"torneo\", \"estudiantes\", \"competencia\"]\n    }\n  ],\n  \"configuracion\": {\n    \"ultimaActualizacion\": \"2024-09-15T16:00:00Z\",\n    \"version\": \"1.0\",\n    \"totalElementos\": 3\n  }\n}"
          },
