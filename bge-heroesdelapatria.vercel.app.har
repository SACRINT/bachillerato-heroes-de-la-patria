          "cookies": [],
          "content": {
            "size": 2376,
            "mimeType": "application/json",
            "text": "{\n  \"avisos\": [\n    {\n      \"id\": \"aviso-001\",\n      \"titulo\": \"Importante: Cambio de Horarios en Biblioteca\",\n      \"contenido\": \"A partir del lunes 18 de septiembre, la biblioteca modificará sus horarios de atención: Lunes a Viernes de 7:00 AM a 7:00 PM, Sábados de 8:00 AM a 2:00 PM. Domingos permanecerá cerrada por mantenimiento del sistema informático.\",\n      \"tipo\": \"importante\",\n      \"fechaInicio\": \"2024-09-15\",\n      \"fechaFin\": \"2024-10-15\",\n      \"dirigidoA\": \"toda la comunidad\",\n      \"prioridad\": \"alta\",\n      \"imagen\": \"images/avisos/horarios-biblioteca.jpg\",\n      \"contacto\": \"biblioteca@bgeheroes.edu.mx\",\n      \"activo\": true,\n      \"fechaCreacion\": \"2024-09-15T08:00:00Z\",\n      \"tags\": [\"biblioteca\", \"horarios\", \"servicios\"]\n    },\n    {\n      \"id\": \"aviso-002\",\n      \"titulo\": \"Recordatorio: Entrega de Documentos de Beca\",\n      \"contenido\": \"Los estudiantes beneficiarios de becas deben entregar la documentación requerida antes del 30 de septiembre en la oficina de Servicios Estudiantiles. Documentos necesarios: constancia de estudios actualizada, comprobante de ingresos familiar y CURP vigente.\",\n      \"tipo\": \"recordatorio\",\n      \"fechaInicio\": \"2024-09-15\",\n      \"fechaFin\": \"2024-09-30\",\n      \"dirigidoA\": \"estudiantes becarios\",\n      \"prioridad\": \"alta\",\n      \"imagen\": \"images/avisos/documentos-beca.jpg\",\n      \"contacto\": \"becas@bgeheroes.edu.mx\",\n      \"activo\": true,\n      \"fechaCreacion\": \"2024-09-15T11:00:00Z\",\n      \"tags\": [\"becas\", \"documentos\", \"estudiantes\", \"fecha límite\"]\n    },\n    {\n      \"id\": \"aviso-003\",\n      \"titulo\": \"Suspensión de Clases por Puente\",\n      \"contenido\": \"Se informa que el viernes 20 de noviembre no habrá clases por puente del Día de la Revolución Mexicana. Las actividades académicas se reanudarán el lunes 23 de noviembre con normalidad.\",\n      \"tipo\": \"informativo\",\n      \"fechaInicio\": \"2024-11-15\",\n      \"fechaFin\": \"2024-11-20\",\n      \"dirigidoA\": \"toda la comunidad\",\n      \"prioridad\": \"media\",\n      \"imagen\": \"images/avisos/suspension-clases.jpg\",\n      \"contacto\": \"direccion@bgeheroes.edu.mx\",\n      \"activo\": true,\n      \"fechaCreacion\": \"2024-09-10T10:00:00Z\",\n      \"tags\": [\"suspensión\", \"clases\", \"puente\", \"feriado\"]\n    }\n  ],\n  \"configuracion\": {\n    \"ultimaActualizacion\": \"2024-09-15T16:00:00Z\",\n    \"version\": \"1.0\",\n    \"totalElementos\": 3\n  }\n}"
          },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 0,
