          "cookies": [],
          "content": {
            "size": 2876,
            "mimeType": "application/json",
            "text": "{\n  \"noticias\": [\n    {\n      \"id\": \"noticia-001\",\n      \"titulo\": \"Inicio del Nuevo Ciclo Escolar 2025-2026\",\n      \"contenido\": \"El Bachillerato General Estatal Héroes de la Patria da la bienvenida a todos los estudiantes al nuevo ciclo escolar. Las clases iniciarán el próximo lunes con protocolos de seguridad actualizados y nuevas modalidades de enseñanza que fortalecerán la formación integral de nuestros jóvenes.\",\n      \"resumen\": \"Bienvenida al nuevo ciclo escolar con protocolos actualizados y modalidades educativas renovadas.\",\n      \"fecha\": \"2024-09-15\",\n      \"autor\": \"Dirección Académica\",\n      \"imagen\": \"images/noticias/inicio-ciclo-2024.jpg\",\n      \"categoria\": \"académico\",\n      \"destacado\": true,\n      \"activo\": true,\n      \"fechaCreacion\": \"2024-09-15T10:00:00Z\",\n      \"tags\": [\"ciclo escolar\", \"bienvenida\", \"protocolos\", \"educación\"]\n    },\n    {\n      \"id\": \"noticia-002\",\n      \"titulo\": \"Inscripciones Abiertas para Talleres Extracurriculares\",\n      \"contenido\": \"Se encuentran abiertas las inscripciones para los talleres de música, danza, teatro, deportes y robótica. Los interesados pueden registrarse en la oficina de actividades estudiantiles hasta el 30 de septiembre. Estos talleres buscan desarrollar habilidades artísticas, deportivas y tecnológicas complementarias a la formación académica.\",\n      \"resumen\": \"Abierta la inscripción a talleres extracurriculares: danza y baile folcloriko, teatro, deportes, banda de guerra y escolta\",\n      \"fecha\": \"2024-09-10\",\n      \"autor\": \"Coordinación Estudiantil\",\n      \"imagen\": \"images/noticias/talleres-extra.jpg\",\n      \"categoria\": \"actividades\",\n      \"destacado\": false,\n      \"activo\": true,\n      \"fechaCreacion\": \"2024-09-10T14:30:00Z\",\n      \"tags\": [\"talleres\", \"extracurriculares\", \"inscripciones\", \"arte\", \"deporte\", \"tecnología\"]\n    },\n    {\n      \"id\": \"noticia-003\",\n      \"titulo\": \"Excelencia Académica: Resultados Olimpiada de Matemáticas 2025\",\n      \"contenido\": \"Nuestros estudiantes obtuvieron resultados sobresalientes en la prueba Olimpiada de Matemáticas 2025, posicionándose en el primer lugar a nivel zona en el área de Matemáticas. Estos logros reflejan el compromiso de nuestra comunidad educativa con la excelencia académica.\",\n      \"resumen\": \"Resultados destacados en la Olimpiada de Matemáticas 2025: primer lugar a nivel Zona en la Olimpiada de Matemáticas.\",\n      \"fecha\": \"2024-09-05\",\n      \"autor\": \"Subdirección Académica\",\n      \"imagen\": \"images/noticias/planea-2024.jpg\",\n      \"categoria\": \"académico\",\n      \"destacado\": true,\n      \"activo\": true,\n      \"fechaCreacion\": \"2024-09-05T12:00:00Z\",\n      \"tags\": [\"PLANEA\", \"excelencia\", \"matemáticas\", \"logros\", \"regional\"]\n    }\n  ],\n  \"configuracion\": {\n    \"ultimaActualizacion\": \"2024-09-15T16:00:00Z\",\n    \"version\": \"1.0\",\n    \"totalElementos\": 3\n  }\n}"
          },
