          "content": {
            "size": 3354,
            "mimeType": "application/json",
            "text": "{\n  \"comunicados\": [\n    {\n      \"id\": \"comunicado-001\",\n      \"titulo\": \"Protocolo de Seguridad y Salud Actualizado\",\n      \"contenido\": \"Se informa a toda la comunidad educativa sobre la actualización del protocolo de seguridad y salud en el plantel. Las nuevas medidas incluyen: uso obligatorio de cubrebocas en espacios cerrados, mantener sana distancia de 1.5 metros, aplicación de gel antibacterial al ingresar a cada aula, y ventilación constante de los espacios educativos. Estas medidas garantizan un ambiente seguro para el aprendizaje.\",\n      \"emisor\": \"Dirección General\",\n      \"fechaEmision\": \"2024-09-14\",\n      \"vigencia\": \"permanente\",\n      \"tipo\": \"oficial\",\n      \"destinatarios\": [\"estudiantes\", \"docentes\", \"personal administrativo\", \"padres de familia\"],\n      \"adjuntos\": [\"protocolo-seguridad-2024.pdf\", \"medidas-sanitarias.pdf\"],\n      \"prioridad\": \"alta\",\n      \"imagen\": \"images/comunicados/protocolo-seguridad.jpg\",\n      \"activo\": true,\n      \"fechaCreacion\": \"2024-09-14T15:00:00Z\",\n      \"tags\": [\"seguridad\", \"salud\", \"protocolo\", \"COVID-19\", \"medidas sanitarias\"]\n    },\n    {\n      \"id\": \"comunicado-002\",\n      \"titulo\": \"Resultados del Proceso de Evaluación Docente\",\n      \"contenido\": \"La Dirección Académica informa los resultados del proceso de evaluación docente correspondiente al ciclo escolar 2023-2024. El 95% de nuestros docentes obtuvieron calificaciones satisfactorias o excelentes. Se reconoce el compromiso y dedicación del personal académico en la formación integral de nuestros estudiantes. Los resultados individuales han sido notificados de manera personal a cada docente.\",\n      \"emisor\": \"Dirección Académica\",\n      \"fechaEmision\": \"2024-09-12\",\n      \"vigencia\": \"temporal\",\n      \"tipo\": \"informativo\",\n      \"destinatarios\": [\"docentes\", \"personal administrativo\"],\n      \"adjuntos\": [\"resultados-evaluacion-docente.pdf\"],\n      \"prioridad\": \"media\",\n      \"imagen\": \"images/comunicados/evaluacion-docente.jpg\",\n      \"activo\": true,\n      \"fechaCreacion\": \"2024-09-12T09:00:00Z\",\n      \"tags\": [\"evaluación\", \"docentes\", \"resultados\", \"calidad educativa\"]\n    },\n    {\n      \"id\": \"comunicado-003\",\n      \"titulo\": \"Convocatoria: Beca de Excelencia Académica 2024-2025\",\n      \"contenido\": \"Se abre la convocatoria para la Beca de Excelencia Académica dirigida a estudiantes que mantengan un promedio mínimo de 9.0. La beca cubre 100% de cuotas escolares y incluye apoyo para materiales didácticos. Los interesados deben presentar solicitud antes del 15 de octubre en Servicios Estudiantiles junto con la documentación requerida: constancia de calificaciones, carta de motivos y comprobante de ingresos familiares.\",\n      \"emisor\": \"Servicios Estudiantiles\",\n      \"fechaEmision\": \"2024-09-20\",\n      \"vigencia\": \"2024-10-15\",\n      \"tipo\": \"convocatoria\",\n      \"destinatarios\": [\"estudiantes\", \"padres de familia\"],\n      \"adjuntos\": [\"convocatoria-beca-excelencia.pdf\", \"requisitos-beca.pdf\"],\n      \"prioridad\": \"alta\",\n      \"imagen\": \"images/comunicados/beca-excelencia.jpg\",\n      \"activo\": true,\n      \"fechaCreacion\": \"2024-09-20T10:00:00Z\",\n      \"tags\": [\"beca\", \"excelencia académica\", \"convocatoria\", \"apoyo estudiantil\"]\n    }\n  ],\n  \"configuracion\": {\n    \"ultimaActualizacion\": \"2024-09-20T16:00:00Z\",\n    \"version\": \"1.0\",\n    \"totalElementos\": 3\n  }\n}"
          },
